# Copia a .env.local. La app pública corre sin estas claves;
# /admin pide sesión cuando Supabase está configurado.

# Sitio. Mejor con https://; si queda vacío o es solo el dominio, el build no se cae.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:43173
NEXT_PUBLIC_WHATSAPP_CHANNEL=https://whatsapp.com/channel/0029Vb8FvlmLI8YeFZWwIs23

# Supabase (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Los proyectos nuevos también exponen una publishable key. Vale cualquiera de las dos.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo servidor. Nunca NEXT_PUBLIC_. No usarla para escribir contenido.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (Fase 3: confirmación, boletín semanal, baja)
RESEND_API_KEY=
RESEND_FROM=El Chakero <noticias@elchakero.com>
