# Copia a mcp/.env. Solo para Cursor en tu máquina. Nunca NEXT_PUBLIC_ ni el navegador.

# Dashboard → Project Settings → API
SUPABASE_URL=
# Preferible: anon o publishable. Así RLS aplica si se cae la sesión.
SUPABASE_ANON_KEY=
# Alternativa local (nunca en el front): si no tienes la anon, vale la service role.
# SUPABASE_SERVICE_ROLE_KEY=

# Cuenta del equipo (reportería, edición o dirección). El MCP entra como esa persona.
# cambiar_estado usa auth.uid() y el rol; sin esto las transiciones fallan.
EL_CHAKERO_EMAIL=
EL_CHAKERO_PASSWORD=
